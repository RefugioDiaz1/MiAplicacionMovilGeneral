<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiAppMovil.Pages.InicioPage"
             BackgroundColor="#FAFBFC"
             Title="Inicio">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="30" VerticalOptions="Center">

            <!-- Ícono central (puede ser imagen real si tienes un logo) -->
            <Label Text="🚀"
                   FontSize="72"
                   HorizontalOptions="Center" />

            <!-- Nombre de la app -->
            <Label Text="Mi App Móvil"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#1E1E2F"
                   HorizontalOptions="Center" />

            <!-- Descripción breve -->
            <Label Text="Optimiza tus tareas diarias con tecnología simple y potente."
                   FontSize="17"
                   TextColor="#5C5C75"
                   HorizontalTextAlignment="Center" />

            <!-- Border con características -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 12">
                
                <Border.Shadow>
                    <Shadow Radius="5" Opacity="0.3" Offset="0,2" Brush="Black" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Label Text="✨ Características destacadas"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#333" />

                    <Label Text="📊 Seguimiento de procesos"
                           FontSize="14"
                           TextColor="#555" />

                    <Label Text="🧠 Inteligencia integrada"
                           FontSize="14"
                           TextColor="#555" />

                    <Label Text="🔒 Seguridad y control de acceso"
                           FontSize="14"
                           TextColor="#555" />

                    <Label Text="📱 Experiencia móvil adaptativa"
                           FontSize="14"
                           TextColor="#555" />
                </VerticalStackLayout>
            </Border>

            <!-- Frase institucional -->
            <Label Text="“Simplifica tu flujo de trabajo desde cualquier lugar.”"
                   FontSize="14"
                   FontAttributes="Italic"
                   TextColor="#888"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
