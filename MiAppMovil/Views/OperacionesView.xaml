<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiAppMovil.Pages.OperacionesPage"
    BackgroundColor="Transparent">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Menú de Operaciones" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="#512BD4" 
                   HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="15" RowSpacing="15">

                <!-- Tarjeta Cotizador Refacciones -->
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#E6E6FA" CornerRadius="15" HasShadow="True" Padding="20">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label Text="🛠️" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Cotizador Refacciones" FontSize="18" TextColor="#512BD4" HorizontalOptions="Center" />
                        <Button Text="Ir" BackgroundColor="#512BD4" TextColor="White" CornerRadius="12" Clicked="CotizadorRefacciones_Clicked"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Tarjeta Unidades Nuevas -->
                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#E6E6FA" CornerRadius="15" HasShadow="True" Padding="20">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label Text="🚗" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Unidades Nuevas" FontSize="18" TextColor="#512BD4" HorizontalOptions="Center" />
                        <Button Text="Ir" BackgroundColor="#512BD4" TextColor="White" CornerRadius="12" Clicked="Unidades_Clicked"/>
                    </VerticalStackLayout>
                </Frame>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
