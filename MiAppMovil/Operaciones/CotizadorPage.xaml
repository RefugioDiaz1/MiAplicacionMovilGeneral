<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiAppMovil.Operaciones.CotizadorPage"
             xmlns:local="clr-namespace:MiAppMovil"
             Title="Cotizador de Refacciones">

    <Grid RowDefinitions="Auto,*" Padding="20" >

        <!-- Fila 0: Flecha fija arriba -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Button Text="← Volver"
                    FontSize="18"
                    BackgroundColor="Transparent"
                    TextColor="#512BD4"
                    HorizontalOptions="Start"
                    Margin="0,20,0,0"
                    Clicked="OnBackButtonClicked" />
        </VerticalStackLayout>

        <!-- Fila 1: Scroll con contenido -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="25" VerticalOptions="Start">

                <!-- Título principal -->
                <Label Text="Consulta de refacciones"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="Black" />

                <!-- Subtítulo -->
                <Label Text="Refacciones"
                       FontSize="20"
                       HorizontalOptions="Center"
                       TextColor="Black" />

                <!-- Instrucción -->
                <Label Text="Introducir número de parte sin guiones"
                       FontSize="16"
                       TextColor="#333"
                       HorizontalOptions="Center" />

                <!-- Switch -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Switch x:Name="FordSwitch" IsToggled="True" Toggled="FordSwitch_Toggled" />
                    <Label x:Name="FordLabel" Text="Ford - 1/" VerticalOptions="Center" TextColor="#111" />
                </HorizontalStackLayout>

                <!-- Cuadro de texto -->
                <Entry x:Name="NumeroParteEntry"
                       Placeholder="Número de parte"
                       FontSize="16"
                       BackgroundColor="White"
                       TextColor="Black"
                       HeightRequest="45"
                       Margin="0,10"
                       HorizontalOptions="Fill" />

                <!-- Panel de alerta debajo del Entry -->
                <Frame x:Name="ErrorAlert"
                       BackgroundColor="#F8D7DA" 
                       BorderColor="#F5C6CB"
                       Padding="10"
                       IsVisible="False"
                       HasShadow="False"
                       CornerRadius="5"
                       HorizontalOptions="Fill">

                    <HorizontalStackLayout VerticalOptions="Center" Spacing="10">
                        <Label x:Name="ErrorAlertLabel"
                               TextColor="#721C24"
                               FontSize="14"
                               VerticalOptions="Center"
                               Text="Mensaje de error aquí" />

                        <Button Text="X"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="#721C24"
                                WidthRequest="30"
                                HeightRequest="30"
                                Padding="0"
                                Clicked="CerrarErrorAlert_Clicked" />
                    </HorizontalStackLayout>
                </Frame>

                <!-- Botones -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Button Text="Buscar"
                            Clicked="Buscar_Clicked"
                            BackgroundColor="#28a745"
                            TextColor="White"
                            CornerRadius="10"
                            WidthRequest="100" />

                    <Button Text="Filtrar"
                            Clicked="Filtrar_Clicked"
                            BackgroundColor="#007bff"
                            TextColor="White"
                            CornerRadius="10"
                            WidthRequest="100" />

                    <Button Text="Limpiar"
                            Clicked="Limpiar_Clicked"
                            BackgroundColor="#dc3545"
                            TextColor="White"
                            CornerRadius="10"
                            WidthRequest="100" />
                </HorizontalStackLayout>



                <ActivityIndicator x:Name="LoadingIndicator"
                   IsRunning="False"
                   IsVisible="False"
                   Color="#007bff"
                   WidthRequest="50"
                   HeightRequest="50"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />


                <!-- Resultados -->
                <CollectionView x:Name="ResultadosView"
                SelectionMode="None"
                ItemsSource="{Binding}"
                Margin="0,20,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="0"
           Margin="10,5"
           BackgroundColor="White"
           CornerRadius="12"
           HasShadow="False"
           BorderColor="#ddd">

                                <Grid Padding="15" ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnResultadoTapped"
                                      CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Parte izquierda: Texto -->
                                    <VerticalStackLayout Spacing="2" Grid.Column="0">
                                        <Label Text="{Binding NumeroParte}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#111" />

                                        <Label Text="{Binding Descripcion}"
                       FontSize="14"
                       TextColor="#666" />
                                    </VerticalStackLayout>

                                    <!-- Parte derecha: Icono -->
                                    <Label Text="🔩"
       FontSize="26"
       VerticalOptions="Center"
       HorizontalOptions="End" />

                                </Grid>
                            </Frame>
                        </DataTemplate>

                    </CollectionView.ItemTemplate>
                </CollectionView>


                <!-- Pie de página -->
                <VerticalStackLayout Padding="30,60,30,20" Spacing="5" HorizontalOptions="Center">
                    <Label Text="© 2025 - Sistema GP" FontSize="12" TextColor="#333" />
                    <Label Text="Página Oficial Ford"
                           FontSize="12"
                           TextColor="#007bff"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenFordPageCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>